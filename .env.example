# Opik
OPIK_URL=https://your-opik-instance/api
OPIK_API_KEY=
OPIK_OTLP_ENDPOINT=https://your-opik-instance/api/v1/private/otel

# Testing project name (must exist in Opik)
EVAL_PROJECT=Testing

# Agent target — full URL of the agent's run endpoint.
# The agent must be reachable over HTTP and emit traces to Opik itself.
# See PREREQUISITES.md for the integration contract.
AGENT_ENDPOINT=
AGENT_AUTH=         # optional — sent as Authorization header if set
AGENT_NAME=agent    # trace filter prefix becomes sim-{run_id}-{AGENT_NAME}
